# ---------- Modo de ejecución ----------
# redshift -> consulta el almacén (cluster real o el contenedor `warehouse` local)
# demo     -> DuckDB + Parquet, sin almacén
OPTIMIZA_SOURCE_MODE=redshift

# ---------- Almacén analítico (Redshift o equivalente) ----------
# Para el almacén local de docker compose, deja estos valores.
# Para un cluster real: host del endpoint, puerto 5439 y credenciales de solo lectura.
REDSHIFT_HOST=warehouse
REDSHIFT_PORT=5432
REDSHIFT_DB=analytics
REDSHIFT_USER=optimiza_ro
REDSHIFT_PASSWORD=optimiza_ro_pwd
REDSHIFT_SCHEMA=analytics
# Timeout de statement en milisegundos
REDSHIFT_STATEMENT_TIMEOUT_MS=15000

# Credenciales administrativas del almacén local (solo las usa el proceso de carga)
WAREHOUSE_ADMIN_USER=optimiza_admin
WAREHOUSE_ADMIN_PASSWORD=optimiza_admin_pwd
WAREHOUSE_DB=analytics
# Puerto del almacén expuesto en tu máquina (para conectarte con psql o un BI)
WAREHOUSE_PORT_HOST=5439

# ---------- Materialización Redshift -> DuckDB ----------
# auto     -> usa la copia local si está fresca; si no, consulta el almacén
# redshift -> siempre consulta el almacén
# cache    -> siempre usa la copia local en DuckDB
QUERY_ROUTING=auto
# Minutos que se considera vigente la copia local
CACHE_MAX_AGE_MIN=720
# Materializa al arrancar si la copia está vacía
SYNC_ON_START=true

# ---------- Límites de ejecución ----------
MAX_ROWS=5000
QUERY_TIMEOUT_S=15
MASK_PII=true

# ---------- LLM (opcional) ----------
# Si no hay API key, el generador SQL determinista offline toma el control.
LLM_PROVIDER=none          # none | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=1200

# ---------- Clasificador edge (español, CPU) ----------
# edge        -> modelo local entrenado en proceso (numpy, CPU, sin GPU)
# transformers-> usa un modelo HuggingFace local (ver EDGE_MODEL_NAME)
# rules       -> fallback por reglas
EDGE_CLASSIFIER_BACKEND=edge
EDGE_MODEL_NAME=luigicfilho/intento-v1-edge

# ---------- Embeddings ----------
# hashing -> embeddings locales deterministas (sin red, sin GPU)
# st      -> sentence-transformers (requiere instalación aparte)
EMBEDDING_BACKEND=hashing
EMBEDDING_DIM=512
ST_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---------- Vector DB ----------
# memory -> índice en proceso (por defecto) | qdrant -> perfil docker `qdrant`
VECTOR_BACKEND=memory
QDRANT_URL=http://qdrant:6333

# ---------- Presentación ----------
# Símbolo de moneda que ve el usuario final
CURRENCY_SYMBOL=S/

# ---------- Costos (para el panel de métricas) ----------
COST_INPUT_USD_PER_MTOK=3.0
COST_OUTPUT_USD_PER_MTOK=15.0
