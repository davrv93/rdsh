  "sql": "WITH comparacion AS (\n  SELECT productos.nombre AS producto,\n         SUM(CASE WHEN ventas.fecha >= DATE '2025-07-01' THEN ventas.margen ELSE 0 END) AS margen_actual,\n         SUM(CASE WHEN ventas.fecha >= DATE '2025-04-01' AND ventas.fecha < DATE '2025-07-01' THEN ventas.margen ELSE 0 END) AS margen_anterior\n  FROM ventas\n  LEFT JOIN productos ON ventas.producto_id = productos.producto_id\n  WHERE ventas.fecha >= DATE '2025-04-01'\n  GROUP BY 1\n)\nSELECT producto,\n       margen_actual,\n       margen_anterior,\n       margen_actual - margen_anterior AS variacion,\n       (margen_actual - margen_anterior) / NULLIF(margen_anterior, 0) AS variacion_pct\nFROM comparacion\nWHERE margen_anterior > 0\nORDER BY variacion_pct ASC\nLIMIT 20",
